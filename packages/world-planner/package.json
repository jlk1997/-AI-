    "test:ci": "vitest run"
  },
  "dependencies": {
    "@opengame/world-ops": "*",
    "@opengame/world-spec": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
