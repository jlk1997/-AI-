{
  "name": "@opengame/world-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLM + heuristic World Spec / Op planner for OpenGame world model.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
