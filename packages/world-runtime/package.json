{
  "name": "@opengame/world-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "World Spec presenters (Phaser 2D MVP + pluggable spatial backends).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "import": "./dist/phaser/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial/index.d.ts",
      "import": "./dist/spatial/index.js"
    }
  },
  "files": [
    "dist",
    "scaffold",
    "scaffold-three"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:scaffold",
    "typecheck:scaffold": "tsc -p tsconfig.scaffold.json",
    "test": "vitest run",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@opengame/world-ops": "*",
    "@opengame/world-sim": "*",
    "@opengame/world-spec": "*"
  },
  "peerDependencies": {
    "phaser": "^3.80.0"
  },
  "peerDependenciesMeta": {
    "phaser": { "optional": true }
  },
  "devDependencies": {
    "phaser": "3.90.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
