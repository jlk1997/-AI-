# Demo / recording profile. Copy the keys you need into the process env.
# Defaults stay off so paid 点亮 / course / publish behavior is unchanged.

PLATFORM_DEMO_OPEN_WORLD=1
# Comma-separated world ids that keep walking even with nobody on the page.
PLATFORM_DEMO_WORLD_IDS=

# Talk volume for a ~100 resident recording. Still counted in Redis.
PLATFORM_SOCIETY_MAX_LLM_TALKS_PER_STEP=3
PLATFORM_SOCIETY_MAX_PARALLEL_TALKS=12
PLATFORM_SOCIETY_MAX_LLM_TALKS_PER_HOUR=400
PLATFORM_SOCIETY_MAX_LLM_TALKS_PER_WORLD_HOUR=180

# Named residents. Default code cap stays 80 unless this is set.
OPENGAME_MAX_NAMED_RESIDENTS=320
OPENGAME_UNIQUE_PORTRAIT_MAX=36

# Frontend (Vite). Restart the web dev server after changing these.
VITE_DEMO_OPEN_WORLD=true

# Compact live frames and pose writes. Off unless set.
OPENGAME_FRAME_COMPACT=1
OPENGAME_POSE_DELTA=1

# Hourly model buckets. Appraisal is reserved so talk cannot spend it.
# Hard-cap alerts fire only while PLATFORM_DEMO_OPEN_WORLD=1.
OPENGAME_LLM_BUCKET_APPRAISAL=80
OPENGAME_LLM_BUCKET_TALK=400
OPENGAME_LLM_BUCKET_REFLECT=80

# Split a fleet across workers. One process keeps the default (all worlds, one at a time).
# OPENGAME_WORKER_SHARDS=2
# OPENGAME_WORKER_SHARD=0
OPENGAME_WORLD_SWEEP_PARALLEL=2
# Per-world hourly model caps. 0 or unset means no extra per-world limit.
OPENGAME_LLM_WORLD_APPRAISAL=40
OPENGAME_LLM_WORLD_TALK=180
OPENGAME_LLM_WORLD_REFLECT=40

# Per-world opinion layer. The global flag above still turns every world on.
# Without it, POST /world/society/mind { "enabled": true } opts in one town.
# OPENGAME_FRAME_COMPACT also sends frame version 2 with a keyframe every 12 ticks.

# Recording script (no live model in CI):
# 1. Generate a large town (~100 named). Crowd cohorts are derived on the first tick.
# 2. Put the world id in PLATFORM_DEMO_WORLD_IDS and let the heartbeat warm it.
# 3. Publish policy "夜市下周起征收摊位费" from the opinion tab.
# 4. Watch appraisals, the support curve, and the crowd dots.
# 5. Publish "官方澄清：低收入摊主减免", then Forecast. The band is 50 Monte Carlo
#    steps on the crowd copy and does not call a model.
# Tuning used here: 3 talks/step, 180/world-hour, 400 platform-hour, 120 named,
# 36 unique portraits, appraisal batch 8.
