# =============================================================================
# OpenGame — example environment configuration
# =============================================================================
#
# Copy this file to `.env` (or export the variables in your shell / CI / Docker)
# and fill in your own keys. ALL keys below belong to YOU — OpenGame does not
# ship with any default credentials and will not call any third-party API
# unless you provide a key.
#
# OpenGame talks to four kinds of generative API, each configured INDEPENDENTLY
# so you can mix providers (e.g. DashScope for image, Doubao for video,
# OpenAI for reasoning).
#
# Resolution order, highest priority first:
#   1. The OPENGAME_<MODALITY>_* env vars below.
#   2. ~/.qwen/settings.json -> openGame.providers.<modality>.{provider,apiKey,baseUrl,model}
#   3. Legacy upstream env vars (DASHSCOPE_API_KEY, IMAGE_MODEL_API_KEY, ...)
#      — kept for backward compatibility but undocumented.
#
# See docs/users/configuration/api-keys.md for the full reference.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Main agent LLM (qwen-code's existing OpenAI-compatible flow)
# -----------------------------------------------------------------------------
# This is the model that drives the agent loop itself. It already exists in
# upstream qwen-code and is not part of the OpenGame provider system; you
# can also configure it interactively with the `/auth` command.

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# MiniMax as main agent (OpenAI-compatible):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# OPENAI_MODEL=MiniMax-M2.7
# See docs/users/configuration/minimax.md


# -----------------------------------------------------------------------------
# 2. Reasoning model (used by `classify-game-type` and `generate-gdd`,
#    and by the audio tool when synthesizing ABC notation)
# -----------------------------------------------------------------------------
# Provider: one of `tongyi` | `doubao` | `openai-compat` | `minimax`
# OPENGAME_REASONING_PROVIDER=openai-compat
# OPENGAME_REASONING_API_KEY=sk-...
# OPENGAME_REASONING_BASE_URL=https://api.openai.com/v1
# OPENGAME_REASONING_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# 3. Image generation (sprites, backgrounds, tilesets, animation base frames)
# -----------------------------------------------------------------------------
# Provider: one of `tongyi` | `doubao` | `openai-compat` | `minimax`
# - `minimax`       -> MiniMax image-01 on api.minimaxi.com (see docs/users/configuration/minimax.md)
# - `tongyi`        -> Aliyun DashScope (Wan family). baseUrl/model optional.
# - `doubao`        -> Volcengine ARK (Seedream family). baseUrl/model optional.
# - `openai-compat` -> any endpoint that implements POST /images/generations
#                     in the OpenAI shape (OpenAI, fal.ai shim, OpenRouter,
#                     Together image routes, Stability proxies, ...).
#                     baseUrl AND model are REQUIRED.

# OPENGAME_IMAGE_PROVIDER=tongyi
# OPENGAME_IMAGE_API_KEY=sk-...
# OPENGAME_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
# OPENGAME_IMAGE_MODEL=wan2.5-t2i-preview


# -----------------------------------------------------------------------------
# 4. Video generation (image-to-video for animation frames; text-to-video as
#    a source for audio extraction)
# -----------------------------------------------------------------------------
# Provider: one of `tongyi` | `doubao` | `minimax`
# `openai-compat` is NOT yet supported for video — Sora / Veo are not part of
# the public OpenAI shape.
# Leave UNSET to disable video generation (animations will fall back to I2I,
# audio to ABC + symusic / procedural).

# OPENGAME_VIDEO_PROVIDER=doubao
# OPENGAME_VIDEO_API_KEY=...
# OPENGAME_VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENGAME_VIDEO_MODEL=doubao-seedance-1-0-pro-250528


# -----------------------------------------------------------------------------
# 5. Audio generation (LLM that writes ABC music notation; the WAV itself is
#    rendered locally via Python `symusic` or a procedural fallback)
# -----------------------------------------------------------------------------
# Provider: one of `tongyi` | `doubao` | `openai-compat` | `minimax`
# Often you can reuse your reasoning provider here.
# Leave UNSET to disable LLM-driven audio (procedural fallback still works).

# OPENGAME_AUDIO_PROVIDER=tongyi
# OPENGAME_AUDIO_API_KEY=sk-...
# OPENGAME_AUDIO_BASE_URL=https://dashscope.aliyuncs.com
# OPENGAME_AUDIO_MODEL=qwen-plus
#
# MiniMax audio (native MP3 first; ABC chat uses OPENGAME_AUDIO_MODEL on /v1):
# OPENGAME_AUDIO_PROVIDER=minimax
# OPENGAME_AUDIO_API_KEY=...
# OPENGAME_AUDIO_MUSIC_MODEL=music-2.6-free
# OPENGAME_AUDIO_SPEECH_MODEL=speech-2.8-turbo
# OPENGAME_AUDIO_VOICE_ID=male-qn-qingse


# -----------------------------------------------------------------------------
# 6. Local helpers
# -----------------------------------------------------------------------------
# Optional: path to a Python interpreter that has `symusic` installed
# (used by the audio tool to render ABC notation -> WAV).
# PYTHON_PATH=/usr/local/bin/python3

# Optional: background removal backend for sprite generation.
# `imgly` (default, pure-JS) | `rembg` (Python)
# BACKGROUND_REMOVAL_BACKEND=imgly

# =============================================================================
# 6b. Provider Key pool + failover（主 MiniMax → 备 火山方舟 Ark / doubao）
# -----------------------------------------------------------------------------
# Trigger: 429 / Token Plan / MiniMax status 2056 / 用量上限 / arrears 403
# Behavior:
#   - Core providerPool: OPENGAME_<MOD>_API_KEYS rotation + health + cooldown
#   - modalities use withProviderPoolFailover (iterate the pool, not one spare)
#   - coding CLI: agentKeyPool rotates OPENAI_* / REASONING_* then FALLBACK_*
#     only when the job paid enough (default ≥10 pts: generate / world_generate)
#   - society floor (free 36/world + 80/platform) NEVER uses FALLBACK keys
#   - society lit (点亮) may use FALLBACK after MiniMax dies, capped per hour
#   - PLATFORM_AGENT_KEY_MAX_ROTATIONS=2
#   - PLATFORM_EMERGENCY_MIN_POINTS=10
#   - PLATFORM_SOCIETY_EMERGENCY_MAX_PER_HOUR=24
# Optional plural keys (same provider/base URL):
#   OPENGAME_REASONING_API_KEYS=sk-a,sk-b
#   OPENGAME_SOCIETY_LIT_API_KEYS=sk-lit-a,sk-lit-b  # optional paid 点亮 pool; falls back to reasoning keys
#   OPENGAME_IMAGE_API_KEYS=sk-a,sk-b
#   OPENAI_API_KEYS=sk-a,sk-b
#   OPENGAME_FALLBACK_API_KEYS=ark-a,ark-b
# Console: https://console.volcengine.com/ark — activate Seedream (required for images)
# Restart platform:dev / worker after changes.
# FALLBACK must have its own BASE_URL + MODEL. Do not point Ark keys at MiniMax.
# Cheap jobs (society seed 2 / build 1 / edit 6) fail honestly instead of burning Ark.
# =============================================================================
# OPENGAME_FALLBACK_PROVIDER=doubao
# OPENGAME_FALLBACK_API_KEY=ark-...
# OPENGAME_FALLBACK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENGAME_REASONING_FALLBACK_MODEL=doubao-seed-2-1-pro-260628
# OPENGAME_IMAGE_FALLBACK_MODEL=doubao-seedream-4-0-250828
# OPENGAME_VIDEO_FALLBACK_MODEL=doubao-seedance-1-0-pro-250528
# OPENGAME_AUDIO_FALLBACK_MODEL=doubao-seed-2-0-lite-260215
# OPENAI_FALLBACK_API_KEY=ark-...
# OPENAI_FALLBACK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_FALLBACK_MODEL=doubao-seed-2-1-pro-260628
# PLATFORM_AGENT_KEY_MAX_ROTATIONS=2
# PLATFORM_EMERGENCY_MIN_POINTS=10
# PLATFORM_SOCIETY_EMERGENCY_MAX_PER_HOUR=24


# =============================================================================
# 7. Hosted platform (apps/platform-* , docker-compose.platform.yml)
# =============================================================================
# See docs/platform/worker-environment.md and docs/platform/hosted-deployment.md
#
# PLATFORM_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/opengame_platform
# PLATFORM_REDIS_URL=redis://127.0.0.1:6380
# PLATFORM_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# PLATFORM_ALLOW_DEV_AUTH=true
# Production hard gates — PLATFORM_RUNTIME=production refuses to boot unless:
#   PLATFORM_ALLOW_DEV_AUTH=false
#   PLATFORM_ALLOW_MOCK_PAYMENTS=false
#   PLATFORM_MAGIC_LINK_ECHO=false
#   PLATFORM_BILLING_ENFORCE_POINTS=true
#   PLATFORM_ALLOW_PUBLIC_PLAY_URLS=false
#   PLATFORM_WEB_BASE_URL or PLATFORM_PUBLIC_BASE_URL set
#   PLATFORM_MAIL_PROVIDER configured  (or PLATFORM_AUTH_WECHAT_ONLY=true)
#   PLATFORM_ALERT_WEBHOOK_URL set
#   PLATFORM_JWT_SECRET is not the example change-me value
#   PLATFORM_PHONE_OTP_ECHO=false
#   PLATFORM_STRIPE_WEBHOOK_SECRET=  # required in prod or Stripe notify returns 503
#   PLATFORM_CORS_ORIGINS=https://play.example
#   PLATFORM_SMS_PROVIDER=          # unset = phone login hidden + 503
#   PLATFORM_MIN_AGE=16
# See docs/platform/launch-day-checklist.md
# PLATFORM_API_PORT=3847
# PLATFORM_WEB_API_BASE=http://127.0.0.1:3847
# Web half-finished surfaces stay hidden unless:
#   VITE_SHOW_ECOSYSTEM=true
#   VITE_SHOW_CUSTOM_DOMAIN=true
#   VITE_SHOW_RESEARCH_LAB=true
#   VITE_SHOW_STRIPE=true
# World 走向盘 is on by default. Set VITE_SHOW_COURSE_MARKET=false to shut the rail.
# Force Stripe on the zh-CN wallet (still needs PLATFORM_STRIPE_API_KEY):
# PLATFORM_BILLING_STRIPE_STOREFRONT=true
#
# Sign-in links (POST /v1/auth/magic/request → /v1/auth/magic/verify).
# Where players open the app; used to build the clickable link:
# PLATFORM_WEB_BASE_URL=http://127.0.0.1:5173
# No mail service yet: set PLATFORM_MAGIC_LINK_ECHO=true yourself in development.
# Production refuses echo. DEV_AUTH no longer implies echo.
# PLATFORM_MAGIC_LINK_ECHO=false
#
# Optional HTTP mail service for those links (no SMTP client involved).
# provider=resend posts to api.resend.com; provider=http posts the same JSON
# ({from,to,subject,text,html}) to your own endpoint. Unset = no delivery.
# PLATFORM_MAIL_PROVIDER=resend
# PLATFORM_MAIL_API_KEY=re_xxx
# PLATFORM_MAIL_FROM=OpenGame <hi@your-domain.com>
# PLATFORM_MAIL_ENDPOINT=https://mail.internal/send
#
# Community curation (feature / unfeature works). Comma-separated emails; empty
# means nobody can curate, which is the safe default:
# PLATFORM_ADMIN_EMAILS=you@your-domain.com
#
# Quotas (platform-api): concurrent = jobs in queued|running per org; daily = jobs created per UTC day.
# PLATFORM_MAX_CONCURRENT_JOBS_PER_ORG=2
# PLATFORM_DAILY_JOB_LIMIT_PER_ORG=500
# Per-plan overrides, comma-separated plan:limit (falls back to the two vars above):
# PLATFORM_PLAN_CONCURRENCY_LIMITS=free:8,pro:16
# PLATFORM_PLAN_DAILY_LIMITS=free:500,pro:5000
#
# Hosted playback. Published games are served through short-lived play sessions
# so a build cannot be mirrored from a permanent URL. Turn this on only if you
# want plain static hosting back (self-host convenience, weaker protection):
# PLATFORM_ALLOW_PUBLIC_PLAY_URLS=false
#
# WeChat Official Account: share cards (JS-SDK) plus web OAuth sign-in. With no
# secret set, sharing falls back to copy-link and sign-in to magic links.
# PLATFORM_WECHAT_APP_ID=wx0123456789abcdef
# PLATFORM_WECHAT_APP_SECRET=...
# Extra origins allowed to request a JS-SDK signature (our own bases are implicit):
# PLATFORM_WECHAT_SHARE_ORIGINS=https://opengame.example
#
# --- Generation points (wallet / ledger / orders) ---------------------------
# Points run alongside the job quotas above: no points means you cannot queue,
# but having points still cannot exceed the concurrency limit. Off by default so
# an existing install does not suddenly refuse to generate.
# PLATFORM_BILLING_ENFORCE_POINTS=true
# Job type → points, comma-separated (defaults: generate:10, world_generate:20,
# world_edit:6, world_train:4, world_society_run:2, build:1, publish:0, bench:2):
# PLATFORM_JOB_POINT_COSTS=generate:10,world_generate:20
# Points granted at the start of each calendar month, per plan:
# PLATFORM_PLAN_MONTHLY_POINTS=free:40,creator:800,studio:4000
# Monthly subscription prices in fen (RMB cents); a plan with no price cannot be bought:
# PLATFORM_PLAN_PRICES=creator:3900,studio:19900
# Point packs as sku:points:fen triples:
# PLATFORM_POINT_PACKS=pack_small:120:900,pack_medium:700:4900,pack_large:1800:11900
# Share of a remix's generation spend paid to the parent author (0–0.5). This is
# what makes an author want their work remixed, so keep it above zero:
# PLATFORM_REMIX_ROYALTY_RATE=0.1
#
# WeChat Pay (APIv3). The APIv3 key also authenticates the notify callback, so
# treat it as a signing secret. Private key accepts \n-escaped single-line PEM.
# PLATFORM_WECHAT_PAY_MCH_ID=1900000000
# PLATFORM_WECHAT_PAY_CERT_SERIAL=5F2...
# PLATFORM_WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# PLATFORM_WECHAT_PAY_APIV3_KEY=32-char-merchant-api-v3-key
# PLATFORM_WECHAT_PAY_NOTIFY_URL=https://api.example.com/v1/public/pay/wechat/notify
#
# Alipay wap pay. The public key is Alipay's, used to verify their notify.
# PLATFORM_ALIPAY_APP_ID=2021000000000000
# PLATFORM_ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# PLATFORM_ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# PLATFORM_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# PLATFORM_ALIPAY_NOTIFY_URL=https://api.example.com/v1/public/pay/alipay/notify
#
# Settle orders through a dev endpoint instead of a real provider. It mints
# points, so it is ignored unless PLATFORM_ALLOW_DEV_AUTH is also true:
# PLATFORM_ALLOW_MOCK_PAYMENTS=true
#
# PLATFORM_S3_ENDPOINT=http://127.0.0.1:9002
# PLATFORM_S3_REGION=us-east-1
# PLATFORM_S3_BUCKET=opengame-platform
# PLATFORM_S3_ACCESS_KEY=minio
# PLATFORM_S3_SECRET_KEY=minio123
# PLATFORM_S3_FORCE_PATH_STYLE=true
# Public MinIO (or CDN) base for browser-direct GET of dist/** — avoids per-file presign when bucket is readable:
# PLATFORM_PUBLIC_OBJECT_BASE_URL=http://127.0.0.1:9002/opengame-platform
# Optional: absolute API origin for preview-proxy URLs when the web app and API are on different hosts (default: same-origin /v1/...):
# PLATFORM_PUBLIC_BASE_URL=http://127.0.0.1:3847
#
# Real generate/build pipeline (worker; paths must exist on the worker host):
# PLATFORM_WORK_ROOT=/var/lib/opengame-platform/work
# Workspace tarball on S3 is ON by default (prefix `workspaces/`). Opt out:
# PLATFORM_WORKSPACE_ARCHIVE_PREFIX=false
# Optional HTTP POST when a job hits the dead-letter (JSON body, no secret).
# Authors always see the studio alert. Production logs a warning if this is empty.
# PLATFORM_ALERT_WEBHOOK_URL=https://ops.example.com/hooks/opengame
# PLATFORM_OPENGAME_CLI=/abs/path/to/OpenGame/dist/cli.js
# PLATFORM_GAME_TEMPLATE_DIR=/abs/path/to/OpenGame/agent-test/templates/core
# PLATFORM_GAME_DOCS_DIR=/abs/path/to/OpenGame/agent-test/docs
# Optional: parent of archetype folders for GAME_TEMPLATES_DIR (default: parent of PLATFORM_GAME_TEMPLATE_DIR)
# PLATFORM_GAME_TEMPLATES_PARENT_DIR=/abs/path/to/OpenGame/agent-test/templates
# Bench jobs run this shell command in the project repo (required for bench; no fake scores):
# PLATFORM_BENCH_COMMAND=npm run test:ci
#
# Scaffold (recommended for hosted generate — aligns with game.json quality gate):
# PLATFORM_PROJECT_SCAFFOLD_MODE=engine
# PLATFORM_RUNTIME_SKELETON_DIR=/abs/path/to/OpenGame/packages/runtime/skeleton-assets
# PLATFORM_RUNTIME_PACKAGE_SPEC=file:/abs/path/to/OpenGame/packages/runtime
# PLATFORM_USE_ARCHETYPE_SCAFFOLD=false
#
# Self-heal loop shaping (see docs/platform/generation-speed.md):
#   PLATFORM_MAX_FIX_ITERATIONS is only a backstop — the real brake is the wall-clock budget.
#   PLATFORM_GATE_ESCALATION=progressive ships a playable preview as soon as the baseline
#   gate passes (agent timeline emits a PREVIEW phase), then keeps polishing towards
#   PLATFORM_GAME_QUALITY_MODE / PLATFORM_QUALITY_BEYOND_BASELINE / PLATFORM_SMOKE_REQUIRE_PROGRESS.
#   Use `strict-first` to restore the old "everything from round 1" behavior.
#   PLATFORM_CLI_TIMEOUT_MS caps round 1 (CODE); FIX rounds decay gently (floor 120s).
#   After a CODE hard-timeout the next round retries full CODE with remaining budget;
#   two consecutive hard timeouts stop the loop (no short-FIX burn).
# PLATFORM_MAX_FIX_ITERATIONS=4
# PLATFORM_GATE_ESCALATION=progressive
# PLATFORM_GENERATION_TIME_BUDGET_MS=1800000
# PLATFORM_CLI_TIMEOUT_MS=900000
#
# Walk cycles: how many genuinely different strides the image model draws per
# direction. Sheets used to repeat one still three times, so characters slid
# instead of walked. The hero gets 2 (contact + passing, 8 renders); a town's
# NPCs get 1 and the remaining slots are derived by mirroring / lifting, because
# a cast of eight at 2 poses would add 64 renders to the asset phase.
# Set both to 3 for a fully drawn cycle, or 1 everywhere for the cheapest path.
# PLATFORM_WALK_REAL_POSES=2
# PLATFORM_WALK_REAL_POSES_NPC=1
#
# Prompt weight. The durable platform contract (~8k chars, identical on every
# job) is written to the workspace as QWEN.md and loaded by the CLI as system
# context instead of being restated in --prompt every round. Set to false to go
# back to inlining it, e.g. when debugging a prompt in isolation.
# PLATFORM_CLI_CONTEXT_FILE=false
# GDD excerpt in the coder prompt (full text is always on disk as GAME_DESIGN.md);
# 0 drops the excerpt entirely. Target-Scene source slice for iteration prompts.
# PLATFORM_CODER_GDD_CHARS=2000
# PLATFORM_TARGET_SCENE_CHARS=4000
#
# Build cache. tsc/vite are skipped when src/ (+ public/ for the bundle) has not
# moved since the last green build — a hard-timeout round no longer spends a
# minute reproducing a byte-identical dist/. Set to false to always rebuild.
# PLATFORM_BUILD_CACHE=false
#
# Early playable delivery. The scaffold is built and published as a preview
# before art and CODE, so a job that later burns its budget still leaves
# something to open; the MiniMax art phase then runs alongside the first CODE
# round and only wires game.json once CODE stops writing it.
# PLATFORM_EARLY_SKELETON_PREVIEW=false
# PLATFORM_ASSET_PARALLEL_CODE=false
# WORLD_EARLY_SKELETON_PREVIEW=false
# Parallel MiniMax image calls (1–8). Raise only with matching provider quota —
# 429s park the key and cost more than they save.
# PLATFORM_ASSET_IMAGE_CONCURRENCY=4
#
# Requirement-fit gate. Mechanics the user named in the prompt ("双人对战",
# "可以钓鱼") are extracted into public/REQUIREMENTS.json and checked against the
# delivered Scene/DSL code — every other gate only checks generic playability, so
# a requested feature could be missing and still pass. Soft by design: a gap can
# spend a FIX round but never revokes an already-published playable preview.
# PLATFORM_REQUIREMENT_GATE=false
# Optional module file: specs (defaults to monorepo packages/module-*):
# PLATFORM_MODULE_DIALOGUE_SPEC=file:/abs/path/to/OpenGame/packages/module-dialogue
# PLATFORM_MODULE_COMBAT_SPEC=file:/abs/path/to/OpenGame/packages/module-combat
#
# BullMQ (platform-worker): lockDuration is auto-renewed while a job runs — it is NOT
# the max runtime. A 3h lock left killed `tsx watch` workers stuck until the lock expired.
# Default is 120s. Only raise if a single sync stretch blocks the event loop that long.
# PLATFORM_BULLMQ_LOCK_DURATION_MS=120000
# PLATFORM_BULLMQ_MAX_STALLED_COUNT=64
# PLATFORM_BULLMQ_STALLED_INTERVAL_MS=45000
# PLATFORM_WORKER_CONCURRENCY=1
#
# Optional: before each generate job, validate OpenGame provider env via packages/core resolver:
# off | all | minimax  (see docs/platform/opengame-minimax-one-stop.md)
# PLATFORM_OPENGAME_PROVIDER_PREFLIGHT=minimax
#
# OpenGame inside worker (same keys as sections 1–6; inject from KMS in prod):
# OPENAI_API_KEY=...
# OPENGAME_REASONING_PROVIDER=...
# etc.
#
# --- World model (symbolic Spec + Sim + optional spatial backends) ---
# PLATFORM_FIX_CONTEXT_BUDGET={"maxTotalChars":8000,"maxRagChars":0,"maxSummaryChars":800,"recentTurnsFull":0}
# WORLD_PLANNER_HEURISTIC=false
# WORLD_NEURAL_INLINE_TRAIN=true
# WORLD_NEURAL_EPISODES=8
# WORLD_NEURAL_EPOCHS=12
# WORLD_SPATIAL_BACKEND=null
# WORLD_SPATIAL_BACKEND=three
# WORLD_SPATIAL_BACKEND=marble
# WORLD_SPATIAL_API_KEY=
#
# --- L3 LingBot-World-v2 (OPTIONAL, DEFAULT OFF, CC BY-NC-SA 4.0 weights) ---
# Cinematic/video layer only: it does not drive dialogue, behaviour or the
# society simulation. Leaving it on without a running sidecar just wastes a
# probe per gated region, so keep WORLD_SPATIAL_BACKEND unset/null unless you
# started services/lingbot-sidecar. See docs/platform/lingbot-world-integration.md
# WORLD_SPATIAL_BACKEND=lingbot
# LINGBOT_ACCEPT_NC_LICENSE=true
# LINGBOT_MODE=mock
# LINGBOT_SIDECAR_URL=http://127.0.0.1:8091
# VITE_LINGBOT_MODE=mock
