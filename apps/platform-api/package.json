{
  "name": "@opengame/platform-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP BFF for the OpenGame hosted platform.",
  "scripts": {
    "predev": "npm run build --workspace=@opengame/platform-db && npm run migrate --workspace=@opengame/platform-db",
    "dev": "node scripts/dev-respawn.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@hono/node-server": "^1.13.8",
    "@opengame/game-planner": "*",
    "@opengame/platform-db": "*",
    "@opengame/platform-rag": "*",
    "@opengame/platform-shared": "*",
    "@opengame/world-agents": "*",
    "@opengame/world-neural": "*",
    "@opengame/world-ops": "*",
    "@opengame/world-planner": "*",
    "@opengame/world-runtime": "*",
    "@opengame/world-sim": "*",
    "@opengame/world-spec": "*",
    "bullmq": "^5.34.10",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.16",
    "ioredis": "^5.4.2",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
