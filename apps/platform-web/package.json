{
  "name": "@opengame/platform-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal web console for the OpenGame hosted platform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
